# Reserved for future provider/API integrations. Never commit real secrets.
TRADE_AGENT_ENVIRONMENT=development
TRADE_AGENT_LOG_LEVEL=INFO
TRADE_AGENT_DATABASE_URL=postgresql+psycopg://trade_agent:change-me@localhost:5432/trade_agent
TRADE_AGENT_AUTO_CREATE_SCHEMA=false
TRADE_AGENT_MAX_REQUEST_BODY_BYTES=2000000
TRADE_AGENT_ECB_ENABLED=true
TRADE_AGENT_ECB_TERMS_APPROVED=false
TRADE_AGENT_ECB_CACHE_TTL_SECONDS=3600
TRADE_AGENT_API_RATE_LIMIT_REQUESTS=120
TRADE_AGENT_API_RATE_LIMIT_WINDOW_SECONDS=60
TRADE_AGENT_AUTH_ENABLED=false
TRADE_AGENT_API_KEY_CREDENTIALS={}
